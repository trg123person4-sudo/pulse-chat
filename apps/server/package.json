{
  "name": "@realtime-chat/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.525.0",
    "@aws-sdk/s3-request-presigner": "^3.525.0",
    "@prisma/client": "^5.10.2",
    "@realtime-chat/shared": "file:../../packages/shared",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tokenizer/token": "^0.3.0",
    "argon2": "^0.40.1",
    "asap": "^2.0.6",
    "assertion-error": "^1.1.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^7.1.5",
    "file-type": "^19.0.0",
    "get-caller-file": "^2.0.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "isarray": "^1.0.0",
    "jose": "^5.2.3",
    "methods": "^1.1.2",
    "multer": "^1.4.5-lts.1",
    "pino": "^8.19.0",
    "pino-http": "^9.0.0",
    "process": "^0.11.10",
    "rate-limit-redis": "^4.2.0",
    "socket.io": "^4.7.4",
    "stackback": "^0.0.2",
    "ulidx": "^2.3.0",
    "util-deprecate": "^1.0.2",
    "uuid": "^9.0.1",
    "vary": "^1.1.2",
    "xtend": "^4.0.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.24",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "@vitest/coverage-v8": "^1.6.1",
    "ioredis-mock": "^8.11.0",
    "pino-pretty": "^10.3.1",
    "prisma": "^5.10.2",
    "socket.io-client": "^4.7.4",
    "supertest": "^6.3.4",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2",
    "vitest": "^1.3.1"
  }
}
