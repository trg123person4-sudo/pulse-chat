# Application
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatdb?schema=public

# Cache & Realtime Pub/Sub (Redis)
REDIS_URL=redis://localhost:6379

# Authentication & Tokens
# Generate keys with: openssl rand -base64 32
JWT_ACCESS_SECRET=c29tZXNlY3JldGFjY2Vzc2tleXZhbHVlMTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM=
JWT_REFRESH_SECRET=c29tZXNlY3JldHJlZnJlc2hrZXl2YWx1ZTEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIz=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# Object Storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=chat-attachments
S3_FORCE_PATH_STYLE=true

# Logging & Limits
LOG_LEVEL=info
MAX_UPLOAD_SIZE_BYTES=26214400

# AI Services (Google Gemini) - REQUIRED
# Required for generative channel "Catch Up" summaries, context-aware smart replies,
# on-demand real-time translation, and LLM-assisted constructive tone checking.
# Without this key, AI features cannot generate responses and fail closed with
# an explicit error rather than misleading silent fallbacks.
GEMINI_API_KEY=your_gemini_api_key_here
